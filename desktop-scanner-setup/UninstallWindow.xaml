<Window x:Class="AlHamidScannerSetup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pencopotan Al-Hamid OMR Scanner" 
        Height="360" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="app_icon.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Grid>
        <!-- Top Red/Amber Banner -->
        <Border Height="70" VerticalAlignment="Top" Background="#DC2626">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="app_icon.ico" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Pencopotan Al-Hamid OMR Scanner" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Hapus aplikasi dan semua komponen dari sistem" FontSize="12" Foreground="#FEE2E2" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Margin="20,85,20,16">
            <!-- Step 1: Confirmation -->
            <Grid x:Name="PanelConfirm" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Apakah Anda yakin ingin menghapus Al-Hamid OMR Scanner?" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <TextBlock Text="Aplikasi, pintasan Desktop, dan menu Start akan dihapus secara permanen dari komputer Anda." TextWrapping="Wrap" FontSize="13" Foreground="#475569" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtInstallLoc" Text="" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Batal" Width="90" Height="32" Margin="0,0,8,0"
                            Background="#E2E8F0" BorderBrush="#CBD5E1" Click="BtnCancel_Click" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="Hapus Aplikasi" Width="120" Height="32"
                            Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnDoUninstall_Click" Cursor="Hand"/>
                </Grid>
            </Grid>

            <!-- Step 2: Uninstalling Progress -->
            <Grid x:Name="PanelProgress" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Width="450">
                    <TextBlock Text="Sedang Menghapus Berkas..." FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtUninstallStatus" Text="Menghapus pintasan..." FontSize="12" Foreground="#64748B" Margin="0,0,0,10"/>
                    <ProgressBar Height="10" IsIndeterminate="True" Foreground="#DC2626" Background="#E2E8F0" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <!-- Step 3: Done -->
            <Grid x:Name="PanelDone" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Pencopotan Selesai!" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Al-Hamid OMR Scanner telah berhasil dihapus dari sistem komputer Anda." TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#334155"/>
                </StackPanel>

                <Button Grid.Row="1" Content="Tutup" Width="100" Height="32" HorizontalAlignment="Right"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnClose_Click" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
