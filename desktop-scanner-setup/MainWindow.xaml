<Window x:Class="AlHamidScannerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalasi Al-Hamid OMR Scanner" 
        Height="500" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="app_icon.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Grid>
        <!-- Top Green Banner -->
        <Border Height="80" VerticalAlignment="Top" Background="#16A34A">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="app_icon.ico" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Pemasangan Al-Hamid OMR Scanner" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Versi 1.0.0 — Madrasah Diniyah Al-Hamid Cintamulya" FontSize="12" Foreground="#DCFCE7" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="24,96,24,20">
            <!-- STEP 1: CONFIGURATION -->
            <Grid x:Name="PanelStep1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Selamat datang di wizard penginstalan Al-Hamid OMR Scanner. Wizard ini akan memasang aplikasi pemindaian lembar jawaban ujian di komputer Anda."
                           TextWrapping="Wrap" FontSize="13" Foreground="#334155" LineHeight="18" Margin="0,0,0,16"/>

                <!-- Directory Selection -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Folder Tujuan Pemasangan:" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"
                                 BorderBrush="#CBD5E1" Background="White"/>
                        <Button Grid.Column="1" Content="Telusuri..." Height="34" Width="90" Margin="8,0,0,0"
                                Background="#E2E8F0" BorderBrush="#CBD5E1" Click="BtnBrowse_Click" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- Options -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Opsi Tambahan:" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Buat ikon pintasan di Desktop (Desktop Shortcut)" IsChecked="True" FontSize="13" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Tambahkan ke Menu Start Windows (Start Menu)" IsChecked="True" FontSize="13"/>
                </StackPanel>

                <!-- Info Box -->
                <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" VerticalAlignment="Top">
                    <TextBlock Text="ℹ️ Ruang disk yang dibutuhkan: ~260 MB. Aplikasi ini self-contained dan sudah mencakup engine Computer Vision OpenCV serta integrasi scanner flatbed."
                               TextWrapping="Wrap" FontSize="12" Foreground="#1E40AF"/>
                </Border>

                <!-- Footer Buttons -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Batal" Width="90" Height="34" Margin="0,0,8,0"
                            Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnCancel_Click" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="Pasang Sekarang" Width="140" Height="34"
                            Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="BtnInstall_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- STEP 2: INSTALLING PROGRESS -->
            <Grid x:Name="PanelStep2" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Width="550">
                    <TextBlock Text="Sedang Memasang Al-Hamid OMR Scanner..." FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Menyiapkan berkas..." FontSize="13" Foreground="#64748B" Margin="0,0,0,14"/>
                    <ProgressBar x:Name="ProgressBarInstall" Height="14" Maximum="100" Value="0" Foreground="#16A34A" Background="#E2E8F0" BorderThickness="0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </Grid>

            <!-- STEP 3: FINISHED -->
            <Grid x:Name="PanelStep3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="64" Height="64" Background="#DCFCE7" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pemasangan Selesai!" FontSize="20" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Al-Hamid OMR Scanner telah berhasil dipasang di komputer Anda." FontSize="13.5" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    
                    <CheckBox x:Name="ChkLaunchApp" Content="Jalankan Al-Hamid OMR Scanner sekarang" IsChecked="True" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Finish Button -->
                <Button Grid.Row="1" Content="Selesai" Width="120" Height="36" HorizontalAlignment="Right"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnFinish_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
