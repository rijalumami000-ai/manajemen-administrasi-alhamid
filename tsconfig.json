{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "rootDir": "./"
  },
  "include": [
    "src/**/*",
    "server.ts",
    "migrate-all.ts",
    "db.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "keuangan",
    "mobile_absensi",
    "mymustahiq",
    "desktop-scanner",
    "dist",
    "public"
  ]
}
