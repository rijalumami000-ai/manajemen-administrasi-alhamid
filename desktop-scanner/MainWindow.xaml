<Window x:Class="AlHamidScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlHamidScanner"
        mc:Ignorable="d"
        Title="Madrasah Al-Hamid - Intelligent OMR Scanner Desktop" 
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Stat Card -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Button Primary -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Secondary -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Selection Ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#4F46E5" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="OMR" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Pusat Pindai Cerdas OMR - Madrasah Diniyah Al-Hamid" Foreground="#F8FAFC" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Windows Native Edition - Sub-Pixel Grid Line Analysis &amp; Auto-Sync" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="VpsStatusBadge" Background="#064E3B" CornerRadius="12" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVpsStatus" Text="VPS Terhubung (Online)" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filter & Selection Ribbon -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Dropdown Selectors -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Tahun Ajaran:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTahunAjaran" Style="{StaticResource ModernComboBox}" SelectedValuePath="Id" DisplayMemberPath="Kode" SelectionChanged="CmbTahunAjaran_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Kelas:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbKelas" Style="{StaticResource ModernComboBox}" SelectedValuePath="Id" DisplayMemberPath="Nama" SelectionChanged="CmbKelas_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Kategori / Sem:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbKategori" Style="{StaticResource ModernComboBox}" SelectedValuePath="Id" DisplayMemberPath="Nama" SelectionChanged="CmbKategori_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Mata Pelajaran:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbMapel" Style="{StaticResource ModernComboBox}" SelectedValuePath="Id" DisplayMemberPath="Nama" SelectionChanged="FilterSelection_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Border x:Name="QrBadge" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <TextBlock x:Name="TxtQrStatus" Text="QR Auto-Detect: Siap" Foreground="#4F46E5" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="BtnBrowseScan_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Buka Berkas Scan (JPG/PNG)" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Click="BtnScanEpson_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ Pindai dari Scanner Epson"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Click="BtnReanalyze_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 Analisis Ulang Lembar Ini"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Content Workspace -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Visual Scanned Sheet Viewer (52%) -->
                <ColumnDefinition Width="52*"/>
                <!-- Splitter -->
                <ColumnDefinition Width="12"/>
                <!-- Right: Results & Scores DataGrid (48%) -->
                <ColumnDefinition Width="48*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Image Viewer -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Pratinjau Lembar Ujian &amp; Deteksi Visual OMR" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ImgPreview" Stretch="None"/>
                                <TextBlock x:Name="TxtImagePlaceholder" Text="Silakan pilih berkas scan atau klik 'Pindai dari Scanner Epson'&#x0a;untuk memulai analisis OMR." 
                                           Foreground="#64748B" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Scores DataGrid -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Summary Metric Cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Table Title & Sync Button -->
                        <RowDefinition Height="Auto"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary Cards Grid -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL SANTRI" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalSantri" Text="0" Foreground="#0F172A" FontSize="20" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="NILAI TERISI" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtFilledSantri" Text="0" Foreground="#16A34A" FontSize="20" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="BELUM TERISI" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtUnfilledSantri" Text="0" Foreground="#D97706" FontSize="20" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="RATA-RATA" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtAverageScore" Text="-" Foreground="#4F46E5" FontSize="20" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Table Header & Action -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tinjauan Nilai Hasil Koreksi Scanner" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Background="#16A34A" Click="BtnSaveToServer_Click" x:Name="BtnSaveToServer" IsEnabled="False">
                            <TextBlock Text="💾 Kirim Nilai ke Database VPS" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Interactive DataGrid -->
                    <DataGrid Grid.Row="2" x:Name="DgResults" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              Background="#FFFFFF"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              RowHeight="36"
                              FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="45" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Consolas, monospace"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Nama Santri" Binding="{Binding Nama}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Nilai OMR" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Nilai, UpdateSourceTrigger=PropertyChanged}" 
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 FontWeight="Bold"
                                                 FontSize="14"
                                                 Margin="4,2"
                                                 TextChanged="TxtNilai_TextChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Status Bar Footer -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusLog" Text="Siap. Silakan buka file hasil scan atau klik 'Pindai dari Scanner Epson'." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Al-Hamid Computer Vision Core v2.0" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
