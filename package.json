{
  "name": "sekolah-info",
  "version": "1.0.0",
  "description": "Sistem informasi internal pesantren dengan backend Node.js dan PostgreSQL.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate-all.js",
    "frontend": "cd frontend && npm run dev",
    "backend": "npm run dev",
    "keuangan:build": "cd keuangan && npx tsc",
    "keuangan:watch": "cd keuangan && npx tsc --watch",
    "keuangan:typecheck": "cd keuangan && npx tsc --noEmit",
    "dev:all": "concurrently \"npm run keuangan:watch\" \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "firebase-admin": "^14.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.5.0",
    "pg": "^8.11.1",
    "vite": "^8.0.10",
    "xlsx": "^0.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
