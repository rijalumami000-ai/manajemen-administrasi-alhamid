# ─── Server Configuration ───────────────────
# Set ke 'production' saat deploy
NODE_ENV=development
PORT=3000

# ─── PostgreSQL Connection ──────────────────
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=your_database_password_here
PGDATABASE=sekolah_info
PGPORT=5432

# ─── JWT Authentication (WAJIB!) ────────────
# Generate random string minimal 32 karakter:
#   PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}) -as [byte[]])
#   Linux/Mac:  openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS Origins (opsional) ────────────────
# Pisahkan dengan koma jika lebih dari satu
# Jika tidak diset, default ke localhost:3000 dan localhost:3001
# IP LAN (192.168.x.x) otomatis diizinkan
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
